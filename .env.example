# Set these before `npm run build`. Next.js inlines NEXT_PUBLIC_* values
# into the static site. Changing them later requires a rebuild (or a new
# Vercel deployment).

# Browser POST target. Formspree example:
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Optional. Sent as JSON `access_key` for Web3Forms-style endpoints.
# This value is public in the built site. Do not put a private secret here.
NEXT_PUBLIC_CONTACT_ACCESS_KEY=

# Used only when ENDPOINT is empty. Opens the visitor's email app.
# Replace with the real Bridgenine inbox before relying on mailto.
NEXT_PUBLIC_CONTACT_EMAIL=
